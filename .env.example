# Copiar a .env y ajustar. Docker Compose lo lee automáticamente.
# Sin .env se usan valores de desarrollo que apuntan al simulador (docker compose --profile simulado up).

API_PORT=8100
LOG_LEVEL=info

# --- Del gateway hacia este MID ---
# Secreto compartido con el API Gateway (cabecera X-Gateway-Secret). Cambiar en cada entorno.
GATEWAY_SECRET=cambiar-este-secreto

# --- Del MID hacia el CRUD de Flota (entre servicios, sin pasar por el gateway) ---
FLOTA_CRUD_URL=http://crud-flota:8000
# Valor del GATEWAY_SECRET configurado en el CRUD de Flota
FLOTA_CRUD_SECRET=cambiar-secreto-del-crud

# --- Del MID hacia Viajes y zonas: siempre por el gateway, con el token de este MID ---
GATEWAY_URL=https://gateway.ejemplo.edu
CLIENT_ID=mid-flota
CLIENT_SECRET=cambiar-secreto-del-mid
# GATEWAY_TOKEN_URL=https://gateway.ejemplo.edu/token     (por defecto: GATEWAY_URL + /token)
# TOKEN_SCOPE=zonas:leer
# ZONAS_RUTA=/viajes/zonas/verificar

# --- Reglas de negocio (valores del enunciado) ---
# RADIO_BUSQUEDA_M=500            radio para buscar vehículos
# BATERIA_MINIMA=25               por debajo no se recomienda
# MAX_RECOMENDACIONES=3
# BATERIA_ALERTA=15               por debajo: alerta
# BATERIA_ALERTA_ALTA=10          por debajo: alerta de prioridad alta
# HORAS_SIN_ACTUALIZAR=2          más de esto sin actualizar la ubicación: alerta
# ESTADOS_ALERTA=disponible       estados que se evalúan en las alertas (separados por coma)

# --- Llamadas a otros servicios ---
# EXTERNOS_TIMEOUT_S=3
# EXTERNOS_REINTENTOS=2
# EXTERNOS_BACKOFF_S=0.2
# CONCURRENCIA_ZONAS=10           consultas simultáneas a Viajes y zonas
# MAX_PAGINAS=10                  páginas máximas al leer el CRUD de Flota
